# API local via proxy do Vite (http://localhost:5173/api -> http://localhost:8080).
VITE_API_URL=/api

# Mantenha este modo enquanto o backend retornar o JWT no corpo do login.
# Use "cookie" somente quando o backend implementar sessão HttpOnly e CSRF.
VITE_AUTH_MODE=legacy-bearer-memory

# Contrato opcional para sessão baseada em cookie.
VITE_AUTH_SESSION_PATH=/auth/me
VITE_AUTH_LOGOUT_PATH=/auth/logout
VITE_CSRF_COOKIE_NAME=XSRF-TOKEN

# "api" usa a API Spring Boot; "local" é apenas para protótipo/testes.
VITE_GUIDE_DATA_SOURCE=api
