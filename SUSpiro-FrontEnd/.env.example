# URL base da API do SUSpiro.
# Desenvolvimento com proxy Vite: deixe ausente e use /api.
# Produção: configure a URL final da API antes do build quando a API estiver em outro domínio.
# VITE_API_URL=https://api.seudominio.gov.br

# Autenticação:
# cookie = modo recomendado para produção: sessão em cookie HttpOnly/Secure/SameSite, sem JWT acessível ao JavaScript.
# legacy-bearer-memory = compatibilidade temporária com o backend atual; o JWT fica apenas em memória e será perdido ao recarregar a página.
VITE_AUTH_MODE=cookie

# Endpoints do contrato de sessão implementado pelo backend.
VITE_AUTH_SESSION_PATH=/auth/me
VITE_AUTH_LOGOUT_PATH=/auth/logout
VITE_CSRF_COOKIE_NAME=XSRF-TOKEN

# Produção: api. Local é somente para protótipo/teste sem backend de guias.
VITE_GUIDE_DATA_SOURCE=api
