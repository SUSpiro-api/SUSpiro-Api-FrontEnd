    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "rimraf": "^6.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^26.1.0",
    "vitest": "^4.1.11"
  }
